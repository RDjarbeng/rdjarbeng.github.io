---
permalink: /post-previews.json
layout: null
eleventyExcludeFromCollections: true
---
{
{% for series in collections.seriesList %}
  {{ series.url | jsonify }}: {
    "title": {{ series.name | jsonify }},
    "excerpt": {{ series.description | default: "Series collection on rdjarbeng.com" | strip_html | strip_newlines | truncate: 160 | jsonify }},
    "date": "Series",
    "read_time": "{{ series.parts.size }} parts",
    "image": {{ series.coverImage | default: "" | jsonify }}
  },
{% endfor %}
{%- comment -%}
  Standalone pages, automatically: any titled page whose source file sits at the repo root
  (about.md, air-quality.md, editorial-policy.md, contact.md...). Posts, gallery items and
  paginated archives live in subfolders or have no title, so they are not repeated here.
{%- endcomment -%}
{% for p in collections.all %}{% assign p_path = p.inputPath | remove_first: "./" %}{% unless p_path contains "/" %}{% if p.data.title and p.url and p.url != "/" %}{% unless p.url contains ".json" or p.url contains ".xml" or p.url contains ".txt" or p.url contains "/series/" or p.data.pagination %}
  {%- assign p_desc = p.data.description | default: "" -%}
  {%- if p_desc == "" -%}{%- assign p_desc = p.content | strip_html | strip_newlines | truncate: 160 -%}{%- endif %}
  {{ p.url | jsonify }}: {
    "title": {{ p.data.title | jsonify }},
    "excerpt": {{ p_desc | strip_html | strip_newlines | truncate: 160 | jsonify }},
    "date": "Page",
    "read_time": "rdjarbeng.com",
    "image": {{ p.data.image | default: "" | jsonify }}
  },
{% endunless %}{% endif %}{% endunless %}{% endfor %}
{% for post in collections.posts %}
  {% assign words = post.content | number_of_words %}
  {% assign raw_minutes = words | divided_by: 180 | round %}
  {% if raw_minutes < 1 %}{% assign mins = 1 %}{% else %}{% assign mins = raw_minutes %}{% endif %}
  {% assign post_desc = post.data.description | default: post.data.excerpt %}
  {% if post_desc == nil or post_desc == '' %}
    {% assign post_desc = post.content | strip_html | strip_newlines | truncate: 160 %}
  {% else %}
    {% assign post_desc = post_desc | strip_html | strip_newlines | truncate: 160 %}
  {% endif %}
  {{ post.url | jsonify }}: {
    "title": {{ post.data.title | jsonify }},
    "excerpt": {{ post_desc | jsonify }},
    "date": {{ post.date | date: "%B %-d, %Y" | jsonify }},
    "read_time": "{{ mins }} min read",
    "image": {{ post.data.image | default: post.data.thumbnail | default: "" | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
}
