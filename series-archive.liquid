---
layout: default
pagination:
  data: collections.seriesList
  size: 1
  alias: seriesItem
permalink: "/series/{{ seriesItem.slug }}/"
eleventyComputed:
  title: "{{ seriesItem.name }}"
  description: "{{ seriesItem.description }}"
  image: "{{ seriesItem.image }}"
---
{%- comment -%} Same structure as the category page (_layouts/category.html), with a part badge on each card {%- endcomment -%}
<div class="categories-tags-container">
  <a href="/series/">All Series</a>|
  <a href="/posts/">All Posts</a>
</div>
<h1>Series: {{ seriesItem.name }} ({{ seriesItem.published.size }} parts)</h1>

{% if seriesItem.description %}
<div class="category-description">
  {{ seriesItem.description | markdownify }}
</div>
{% endif %}

<div class="post-list">
  {% for part in seriesItem.parts %}
    {% if part.card %}
      {% capture part_badge %}Part {{ part.number }}{% endcapture %}
      {% include post-card.html post=part.card badge=part_badge %}
    {% endif %}
  {% endfor %}
</div>

{% assign upcoming = seriesItem.parts.size | minus: seriesItem.published.size %}
{% if upcoming > 0 %}
<p class="series-upcoming-note">{{ upcoming }} more {% if upcoming == 1 %}part is{% else %}parts are{% endif %} on the way.</p>
{% endif %}
