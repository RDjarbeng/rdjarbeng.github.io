---
permalink: /sitemap.xml
layout: null
eleventyExcludeFromCollections: true
---
{%- comment -%}
  Lists only pages with original content: technical and personal posts,
  series pages and the main hubs. Gallery items, video embeds, tag and
  category listings are left out on purpose: they made up 85% of the old
  sitemap, and a sitemap that is mostly thin or duplicate pages lowers how
  much of the site Google crawls and indexes. Those pages stay reachable
  through links. A page can still opt out with `sitemap: false` or
  `noindex: true` in its front matter.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign hubs = "/,/posts/,/personal/,/series/,/about/,/projects/" | split: "," %}
{%- for hub in hubs %}
  <url><loc>{{ site.url }}{{ hub }}</loc></url>
{%- endfor %}
{%- for post in site.posts %}
  {%- unless post.sitemap == false or post.noindex == true %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.updated | default: post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
  {%- endunless %}
{%- endfor %}
{%- for post in site.personal %}
  {%- unless post.sitemap == false or post.noindex == true %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.updated | default: post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
  {%- endunless %}
{%- endfor %}
{%- for s in collections.seriesList %}
  <url>
    <loc>{{ site.url }}{{ s.url }}</loc>
    {%- if s.updated %}
    <lastmod>{{ s.updated | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
