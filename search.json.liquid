---
layout: null
permalink: /search.json
---
[
  {% for post in collections.searchable %}
    {% assign words = post.content | default: post.templateContent | number_of_words %}
    {% assign minutes = words | divided_by: 180 | ceil %}
    {% if minutes < 1 %}{% assign minutes = 1 %}{% endif %}
    {% capture image_html %}
      {% if post.data.image %}
        <div class="post-card-image">
          <img src="{{ post.data.image }}" alt="{{ post.data.title | escape }}" class="post-image" loading="lazy">
        </div>
      {% elsif post.data.thumbnail %}
        <div class="post-card-image">
          <img src="{{ post.data.thumbnail }}" alt="{{ post.data.title | escape }}" class="post-image" loading="lazy">
        </div>
      {% endif %}
    {% endcapture %}
    {
      "title"       : {{ post.data.title | jsonify }},
      "url"         : {{ post.url | relative_url | jsonify }},
      "date"        : {{ post.date | date: "%B %-d, %Y" | jsonify }},
      "read_time"   : "{{ minutes }} min read",
      "image_html"  : {{ image_html | strip | jsonify }},
      "excerpt"     : {{ post.data.description | default: post.data.excerpt | strip_html | strip_newlines | truncate: 200 | jsonify }},
      "categories"  : {{ post.data.category | default: "" | jsonify }},
      "tags"        : {{ post.data.tags | join: ", " | jsonify }},
      "type"        : {{ post.data.type | default: "post" | jsonify }},
      "display_type": {{ post.data.type | default: "Post" | capitalize | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]